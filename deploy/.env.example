# Copier en deploy/.env puis remplir
DOMAINE=adet.sn
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_long
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=

S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Notifications push de l'espace pro (facultatif) ----------
# Sans ces clés, la cloche marche mais rien n'arrive sur les téléphones.
# Générer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adetsenegal1@gmail.com

# ---------- Visio de l'espace pro : 8x8 JaaS (facultatif) ----------
# Sans ces clés : service public meet.jit.si (le premier entrant se connecte pour ouvrir la salle).
# Compte gratuit sur https://jaas.8x8.vc (jusqu'à 25 utilisateurs par mois) → API Keys → « Add API key ».
JAAS_APP_ID=
JAAS_API_KEY_ID=
# Clé privée PEM sur une seule ligne, retours à la ligne remplacés par \n
JAAS_PRIVATE_KEY=
