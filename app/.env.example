# ---------- Obligatoire ----------
DATABASE_URL=postgres://adet:adet@127.0.0.1:5432/adet
# Chaîne longue et aléatoire (ex. : openssl rand -hex 32)
PAYLOAD_SECRET=CHANGE_ME
# Adresse publique du site (liens des e-mails, sitemap, partages, CSRF)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- E-mails (facultatif : sans SMTP, les e-mails s'affichent dans la console) ----------
# Exemple Gmail : SMTP_HOST=smtp.gmail.com SMTP_PORT=465 + mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@adet.sn
# Destinataire des alertes « nouveau message » (par défaut : e-mail des coordonnées)
NOTIFICATION_EMAIL=

# ---------- Stockage des médias dans le cloud (facultatif) ----------
# Compatible S3 : AWS, Cloudflare R2, Scaleway, OVH…
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Notifications push de l'espace pro (facultatif) ----------
# Sans ces clés, la cloche marche mais rien n'arrive sur les téléphones.
# Générer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adetsenegal1@gmail.com
